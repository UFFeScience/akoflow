# Optional for local development: docker-compose.yml provides a localhost-only
# development token. Set a high-entropy value for shared deployments:
# openssl rand -hex 32
AKOFLOW_API_TOKEN=replace-with-a-random-secret
# Comma-separated browser origins. Do not use * for an authenticated API.
AKOFLOW_API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional MCP endpoint on the daemon HTTP listener. Disabled by default.
AKOFLOW_MCP_ENABLED=false
AKOFLOW_MCP_PERMISSIONS=read
AKOFLOW_MCP_STATE_DIRECTORY=
# Set a separate high-entropy token through server-side secret management:
AKOFLOW_MCP_TOKEN=
AKOFLOW_MCP_ALLOWED_ORIGINS=
# Optional external OAuth provider; replaces static MCP-token authentication.
AKOFLOW_MCP_PUBLIC_URL=
AKOFLOW_MCP_OAUTH_ISSUER=
AKOFLOW_MCP_OAUTH_INTROSPECTION_URL=
AKOFLOW_MCP_OAUTH_CLIENT_ID=
AKOFLOW_MCP_OAUTH_CLIENT_SECRET=

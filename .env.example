# Optional for local development: docker-compose.yml provides a localhost-only
# development token. Set a high-entropy value for shared deployments:
# openssl rand -hex 32
AKOFLOW_API_TOKEN=replace-with-a-random-secret
# Comma-separated browser origins. Do not use * for an authenticated API.
AKOFLOW_API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

{
  "name": "transfer-matrix-local-hpc",
  "spec": {
    "namespace": "transfer-matrix",
    "image": "docker.io/library/busybox:1.36",
    "activities": [
      {
        "name": "produce",
        "runtime": "local",
        "cpuLimit": "0.1",
        "memoryLimit": "16Mi",
        "run": "set -eu\nprintf route=+local+-+hpc+\nsequence=1\n > payload.txt\nsha256sum payload.txt > payload.sha256\ntest -s payload.txt"
      },
      {
        "name": "consume",
        "runtime": "slurm",
        "cpuLimit": "0.1",
        "memoryLimit": "16Mi",
        "dependsOn": [
          "produce"
        ],
        "run": "set -eu\ntest -s payload.txt\nsha256sum -c payload.sha256\ngrep -qx route=+local+-+hpc+ payload.txt\nprintf consumed=+hpc+\n > receipt.txt"
      }
    ],
    "dataDependencies": [
      {
        "producerActivity": "produce",
        "consumerActivity": "consume",
        "logicalName": "payload.txt",
        "sizeBytes": 27
      },
      {
        "producerActivity": "produce",
        "consumerActivity": "consume",
        "logicalName": "payload.sha256",
        "sizeBytes": 78
      }
    ]
  }
}

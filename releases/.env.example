# The desktop application generates this file in its private application-data
# directory. Values here are safe examples for a manual installation.
AKOFLOW_VERSION=v0.1.0
AKOFLOW_PORT=8080
AKOFLOW_API_TOKEN=replace-with-a-random-secret
AKOFLOW_API_ALLOWED_ORIGINS=http://127.0.0.1
AKOFLOW_CONSOLE_ENABLED=true
